# ============================================
# SKILLSPHERE — Environment Variables
# Copy to .env and fill in. Values left as `your_...` placeholders
# are treated as "not configured" and the feature degrades gracefully.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (required). For local dev: mongodb://127.0.0.1:27017/skillsphere_dev
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillsphere?retryWrites=true&w=majority

# JWT (required, ≥ 32 chars each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL (required, used for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary (optional – uploads return 503 without it)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay — TEST MODE keys only (optional – payments return 503 without it)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email (optional – dev falls back to an Ethereal test inbox; preview URLs are logged)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=
# false = unverified accounts can still post gigs, apply and pay (demo without SMTP)
REQUIRE_EMAIL_VERIFICATION=true

# Hugging Face (optional – AI features use a non-AI fallback without it)
HF_ACCESS_TOKEN=your_hugging_face_token_here

# Redis (optional – in-memory cache without it)
REDIS_URL=

# Search: set to true to use MongoDB Atlas Search ($search) instead of $text/regex
USE_ATLAS_SEARCH=false

# Platform
ADMIN_EMAIL=admin@skillsphere.com
PLATFORM_FEE_PERCENTAGE=10
