# ============================================
# SKILLSPHERE client — build-time variables (Vite exposes only VITE_* names)
# Copy to client/.env.local for local overrides. All optional.
# ============================================

# Where the API lives, without a path, e.g. https://skillsphere-api.onrender.com
# Leave empty in local dev: the Vite dev server proxies /api and /socket.io to :5000.
VITE_API_URL=

# The site's public URL, for absolute og:image / og:url link previews. Netlify (URL) and Vercel
# (VERCEL_PROJECT_PRODUCTION_URL) provide it automatically; set it on other hosts.
VITE_PUBLIC_URL=

# Optional TURN relay for video calls. Without it calls use STUN only and can fail behind
# symmetric NAT (mobile data, strict office networks). Comma-separate several URLs, e.g.
#   turn:turn.example.com:3478,turns:turn.example.com:5349
# These values end up in the public bundle: use restricted or short-lived TURN credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
