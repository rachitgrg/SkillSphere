# ============================================
# SKILLSPHERE client — build-time variables (Vite exposes only VITE_* names)
# Copy to client/.env.local for local overrides. All optional.
# ============================================

# Where the API lives, without a path, e.g. https://skillsphere-api.onrender.com
# Leave empty in local dev: the Vite dev server proxies /api and /socket.io to :5000.
VITE_API_URL=
